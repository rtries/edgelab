# ── Postgres ────────────────────────────────────────────────
POSTGRES_USER=edgelab
POSTGRES_PASSWORD=change-me
POSTGRES_DB=edgelab
DATABASE_URL=postgresql+asyncpg://edgelab:change-me@db:5432/edgelab

# ── Redis / Celery ──────────────────────────────────────────
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# ── API ─────────────────────────────────────────────────────
API_ENV=development
API_CORS_ORIGINS=["http://localhost:3000"]
SECRET_KEY=generate-a-real-one   # openssl rand -hex 32

# ── Auth (Supabase-issued JWTs, verified against this secret) ─
# Supabase dashboard: Project Settings -> API -> JWT Secret
SUPABASE_JWT_SECRET=
# Local dev / tests ONLY — the app refuses to start with this
# true unless API_ENV=development. Never set in a deployed env.
AUTH_DISABLED=true

# ── Ops (Phase 5) data root, per-user namespaced ─────────────
EDGELAB_OPS_ROOT=ops_data
EDGELAB_RESEARCH_ROOT=research_data
EDGELAB_DATA_ROOT=data/store

# ── Market data / brokers (fill in later phases) ────────────
ALPACA_API_KEY=
ALPACA_API_SECRET=
ALPACA_PAPER=true          # live trading is DISABLED by default by design
POLYGON_API_KEY=

# ── AI research assistant ───────────────────────────────────
ANTHROPIC_API_KEY=
